{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build:vercel",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://bio2dsactv-kdvb4ut4.manus.space/api/:path*"
    },
    {
      "source": "/manus-storage/:path*",
      "destination": "https://bio2dsactv-kdvb4ut4.manus.space/manus-storage/:path*"
    },
    {
      "source": "/((?!api/|manus-storage/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ]
}
